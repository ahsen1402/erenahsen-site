body.home-page { background:#fff; color:#14213d; }
.home-page main { max-width:none; }
.home-page .masthead { margin-bottom:0; }
.home-page .hero { display:grid; grid-template-columns:minmax(300px,38%) minmax(0,62%); min-height:560px; }
.home-page .hero-media { min-height:560px; overflow:hidden; background:#f5f7fa; display:flex; align-items:center; justify-content:center; padding:42px; }
.home-page .hero-media img { width:min(330px,100%); height:auto; max-height:460px; object-fit:contain; object-position:center; display:block; border-radius:4px; box-shadow:0 12px 32px rgba(16,42,86,.10); }
.home-page .hero-copy { padding:64px clamp(36px,6vw,96px); display:flex; flex-direction:column; justify-content:center; }
.home-page .hero-copy h1 { font-size:clamp(42px,5vw,68px); line-height:1.02; margin:0 0 22px; letter-spacing:-1.8px; }
.home-page .hero-copy p { max-width:640px; font-size:18px; line-height:1.75; color:#334155; margin:0 0 22px; }
.home-page .hero-copy .hero-lead { font-size:20px; }
.home-page .accent-line { width:64px; height:4px; background:#f05a28; margin-bottom:24px; }
.home-page .accent-center { margin:0 auto 20px; }
.home-page .hero-actions { display:flex; gap:14px; margin-top:14px; flex-wrap:wrap; }
.home-page .btn { display:inline-flex; align-items:center; gap:9px; padding:13px 24px; text-decoration:none; border-radius:3px; font-weight:700; }
.home-page .btn-primary { background:#102a56; color:#fff; }
.home-page .btn-primary:hover { background:#173b77; color:#fff; }
.home-page .btn-secondary { border:1px solid #102a56; color:#102a56; background:#fff; }
.home-page .btn-secondary:hover { background:#f4f7fb; color:#102a56; }
.home-page .section { padding:72px 6vw; }
.home-page .section-heading { max-width:820px; margin:0 auto 40px; text-align:center; }
.home-page .section-heading h2 { font-size:38px; margin:0 0 8px; letter-spacing:-.8px; }
.home-page .section-heading p { color:#566274; font-size:17px; line-height:1.7; margin:0; }
.home-page .interest-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:24px; max-width:1200px; margin:0 auto; }
.home-page .interest-card { border:1px solid #e3e8ef; padding:34px 28px; text-align:center; background:#fff; box-shadow:0 5px 18px rgba(16,42,86,.035); }
.home-page .interest-icon { width:62px; height:62px; margin:0 auto 20px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:29px; font-weight:700; background:#f7f9fc; }
.home-page .interest-icon.blue { color:#3b82f6; }
.home-page .interest-icon.orange { color:#f05a28; }
.home-page .interest-icon.green { color:#4b9a4c; }
.home-page .interest-icon.purple { color:#7057c5; }
.home-page .interest-card h3 { font-size:21px; margin:0 0 12px; color:#102a56; }
.home-page .interest-card p { margin:0; color:#566274; line-height:1.65; }
.home-page .feature-strip { background:#f5f7fa; display:grid; grid-template-columns:1.4fr 1fr 1fr; gap:48px; padding-top:56px; padding-bottom:56px; }
.home-page .feature-title { font-size:15px; font-weight:800; text-transform:uppercase; letter-spacing:.08em; color:#102a56; margin-bottom:14px; }
.home-page .feature-title:after { content:''; display:block; width:34px; height:3px; background:#f05a28; margin-top:9px; }
.home-page .feature-block h3 { font-size:23px; line-height:1.35; margin:0 0 12px; color:#102a56; }
.home-page .feature-block p { color:#566274; line-height:1.7; }
.home-page .feature-block a { color:#1f67d2; font-weight:700; text-decoration:none; }
.home-page .feature-block a:hover { text-decoration:underline; }
.home-page .explore-links { display:grid; grid-template-columns:1fr 1fr; gap:12px 20px; }
.home-page .explore-links a { color:#102a56; font-weight:700; }
@media (max-width: 980px) {
  .home-page .hero { grid-template-columns:1fr; }
  .home-page .hero-media { min-height:360px; padding:32px; }
  .home-page .hero-media img { width:min(290px,80%); max-height:360px; }
  .home-page .hero-copy { padding:54px 7vw 64px; }
  .home-page .interest-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
  .home-page .feature-strip { grid-template-columns:1fr; gap:32px; }
}
@media (max-width: 560px) {
  .home-page .hero-media { min-height:300px; }
  .home-page .hero-media img { width:220px; }
  .home-page .hero-copy h1 { font-size:40px; }
  .home-page .hero-copy p { font-size:16px; }
  .home-page .interest-grid { grid-template-columns:1fr; }
  .home-page .section { padding:56px 20px; }
}
